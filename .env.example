# debroxy configuration (spec §11). Copy to .env and edit.
#
# Uncommented lines are required; commented lines show the default.
# Lists are comma-separated, durations are Go durations ("30s", "720h"),
# booleans are true or false. Every secret variable NAME may instead be
# given as NAME_FILE, a path to a file holding the value (Docker secrets).
# Unknown DEBROXY_* variables stop startup.

# --- Storage ---------------------------------------------------------------
# Directory for debroxy.db and its lock file; the image sets /data (a volume).
DEBROXY_DATA_DIR=/data
# DEBROXY_DATABASE_READER_CONNECTIONS=4

# --- Server ----------------------------------------------------------------
# The URL users reach debroxy at: scheme and host only, no path.
DEBROXY_SERVER_PUBLIC_BASE_URL=https://debroxy.example.org
# DEBROXY_SERVER_LISTEN=:8080
# X-Forwarded-For is trusted only from these CIDRs or addresses.
# DEBROXY_SERVER_TRUSTED_PROXIES=
# Running requests get this long on shutdown.
# DEBROXY_SERVER_SHUTDOWN_TIMEOUT=30s
# debug, info, warn or error.
# DEBROXY_LOG_LEVEL=info

# --- First admin -----------------------------------------------------------
# If set, serve creates this admin on an empty database and skips otherwise.
# The password needs at least 12 characters.
# DEBROXY_BOOTSTRAP_ADMIN_USERNAME=root
# DEBROXY_BOOTSTRAP_ADMIN_PASSWORD=

# --- Identity --------------------------------------------------------------
# DEBROXY_IDENTITY_SESSION_ABSOLUTE_LIFETIME=720h
# DEBROXY_IDENTITY_SESSION_IDLE_TIMEOUT=168h
# DEBROXY_IDENTITY_OIDC_ENABLED=false
# DEBROXY_IDENTITY_OIDC_ISSUER_URL=https://auth.example.org
# DEBROXY_IDENTITY_OIDC_CLIENT_ID=debroxy
# DEBROXY_IDENTITY_OIDC_CLIENT_SECRET=
# DEBROXY_IDENTITY_OIDC_SCOPES=openid,profile,email

# --- Jobs ------------------------------------------------------------------
# DEBROXY_JOB_DEFAULT_SLOT_QUOTA=3
# DEBROXY_JOB_UPLOAD_LIMIT_BYTES=10485760
# DEBROXY_JOB_SUBMIT_RATE_PER_HOUR=10
# DEBROXY_JOB_SUBMIT_RATE_CACHED_PER_HOUR=60
# DEBROXY_JOB_FORCED_REFRESH_PER_USER_PER_MINUTE=2
# DEBROXY_JOB_EVENTS_MAX_STREAMS_PER_USER=4
# DEBROXY_JOB_EVENTS_MAX_STREAMS_TOTAL=256
# DEBROXY_JOB_REFRESH_MAX_AGE=10s
# DEBROXY_JOB_SAFETY_REFRESH_ACTIVE=5m
# DEBROXY_JOB_SAFETY_REFRESH_IDLE=30m
# DEBROXY_JOB_STALL_THRESHOLD=30m
# Must exceed the last follow-up refresh.
# DEBROXY_JOB_SUBMISSION_TIMEOUT=20m
# DEBROXY_JOB_SUBMIT_REQUEST_DEADLINE=10s
# Overridable per provider.
# DEBROXY_JOB_ABSENCE_GRACE=60s
# DEBROXY_JOB_REFRESH_BACKOFF_INITIAL=5s
# DEBROXY_JOB_REFRESH_BACKOFF_MAX=2m
# DEBROXY_JOB_FOLLOW_UP_REFRESHES=30s,2m,5m,10m,15m
# DEBROXY_JOB_WEBHOOK_REFRESH_INTERVAL=30s
# DEBROXY_JOB_OUTBOX_MAX_ATTEMPTS=20
# DEBROXY_JOB_OUTBOX_INITIAL_BACKOFF=1s
# DEBROXY_JOB_OUTBOX_MAX_BACKOFF=1h
# DEBROXY_JOB_RETENTION_JOB_HISTORY=4320h
# DEBROXY_JOB_RETENTION_UNMANAGED_ITEMS_UNSEEN=168h
# DEBROXY_JOB_RETENTION_PROCESSED_OUTBOX=720h
# DEBROXY_JOB_RETENTION_DELETED_ITEMS=720h

# --- Delivery --------------------------------------------------------------
# DEBROXY_DELIVERY_SIGNED_LINK_TTL=6h
# DEBROXY_DELIVERY_MAX_STREAMS_PER_USER=4
# DEBROXY_DELIVERY_MAX_CONCURRENT_STREAMS=64
# Signed Link keys: the first ID signs, every listed ID verifies.
DEBROXY_SIGNING_KEYS=k1
# At least 32 bytes, e.g. from: openssl rand -base64 48
DEBROXY_SIGNING_KEY_K1=change-me-to-at-least-32-random-bytes

# --- Providers -------------------------------------------------------------
# Provider IDs (lowercase letters, digits, dashes). Each ID's variables are
# DEBROXY_PROVIDER_<ID>_*, with the ID upper-cased and "-" as "_".
DEBROXY_PROVIDERS=torbox,realdebrid

# torbox or realdebrid.
DEBROXY_PROVIDER_TORBOX_KIND=torbox
DEBROXY_PROVIDER_TORBOX_API_KEY=change-me
# DEBROXY_PROVIDER_TORBOX_DISPLAY_NAME=TorBox
# DEBROXY_PROVIDER_TORBOX_ENABLED=true
# Sent on API and CDN requests.
# DEBROXY_PROVIDER_TORBOX_USER_AGENT=debroxy/0.1
# DEBROXY_PROVIDER_TORBOX_BASE_URL=https://api.torbox.app/v1/api
# DEBROXY_PROVIDER_TORBOX_TIMEOUT=30s
# DEBROXY_PROVIDER_TORBOX_RETRY_MAX_ATTEMPTS=3
# DEBROXY_PROVIDER_TORBOX_RETRY_BASE_DELAY=500ms
# DEBROXY_PROVIDER_TORBOX_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# DEBROXY_PROVIDER_TORBOX_CIRCUIT_BREAKER_OPEN_DURATION=30s
# ipv4 or ipv6; all traffic of the account leaves through this family.
# DEBROXY_PROVIDER_TORBOX_EGRESS_IP_FAMILY=ipv4
# DEBROXY_PROVIDER_TORBOX_EGRESS_LOCAL_ADDRESS=
# DEBROXY_PROVIDER_TORBOX_CDN_LINK_CACHE_MAX=30m
# Startup egress probe hosts (host or host:port); empty means the kind's defaults.
# DEBROXY_PROVIDER_TORBOX_CDN_PROBE_HOSTS=
# Overrides DEBROXY_JOB_ABSENCE_GRACE for this provider.
# DEBROXY_PROVIDER_TORBOX_ABSENCE_GRACE=60s
# DEBROXY_PROVIDER_TORBOX_DISABLED_CAPABILITIES=
# Rate budgets: <requests>/<duration>.
# DEBROXY_PROVIDER_TORBOX_RATE_BUDGET_GENERAL=300/60s
# DEBROXY_PROVIDER_TORBOX_RATE_BUDGET_UNCACHED_CREATE=60/1h
# DEBROXY_PROVIDER_TORBOX_RATE_BUDGET_CDN_ZIP=60/60s
# Webhook URL: https://<public base URL>/webhooks/torbox/<secret>; secret >= 32 bytes.
# DEBROXY_PROVIDER_TORBOX_WEBHOOK_ENABLED=false
# DEBROXY_PROVIDER_TORBOX_WEBHOOK_SECRET=

DEBROXY_PROVIDER_REALDEBRID_KIND=realdebrid
DEBROXY_PROVIDER_REALDEBRID_API_KEY=change-me
# DEBROXY_PROVIDER_REALDEBRID_DISPLAY_NAME=Real-Debrid
# DEBROXY_PROVIDER_REALDEBRID_ENABLED=true
# DEBROXY_PROVIDER_REALDEBRID_USER_AGENT=debroxy/0.1
# DEBROXY_PROVIDER_REALDEBRID_BASE_URL=https://api.real-debrid.com/rest/1.0
# DEBROXY_PROVIDER_REALDEBRID_TIMEOUT=30s
# DEBROXY_PROVIDER_REALDEBRID_RETRY_MAX_ATTEMPTS=3
# DEBROXY_PROVIDER_REALDEBRID_RETRY_BASE_DELAY=500ms
# DEBROXY_PROVIDER_REALDEBRID_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# DEBROXY_PROVIDER_REALDEBRID_CIRCUIT_BREAKER_OPEN_DURATION=30s
# DEBROXY_PROVIDER_REALDEBRID_EGRESS_IP_FAMILY=ipv4
# DEBROXY_PROVIDER_REALDEBRID_EGRESS_LOCAL_ADDRESS=
# DEBROXY_PROVIDER_REALDEBRID_CDN_LINK_CACHE_MAX=30m
# DEBROXY_PROVIDER_REALDEBRID_CDN_PROBE_HOSTS=
# DEBROXY_PROVIDER_REALDEBRID_ABSENCE_GRACE=60s
# DEBROXY_PROVIDER_REALDEBRID_DISABLED_CAPABILITIES=
# DEBROXY_PROVIDER_REALDEBRID_RATE_BUDGET_GENERAL=250/60s
# Real-Debrid offers no webhooks.

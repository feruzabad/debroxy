{
  "name": "debroxy-web",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "gen:api": "openapi-typescript ../api/openapi/identity.yml -o src/api/generated/identity.ts && openapi-typescript ../api/openapi/job.yml -o src/api/generated/job.ts && openapi-typescript ../api/openapi/delivery.yml -o src/api/generated/delivery.ts && openapi-typescript ../api/openapi/client.yml -o src/api/generated/client.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "biome check . && tsc -b && vitest run && pnpm audit --prod --audit-level high && pnpm run build && node scripts/check-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.46",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
